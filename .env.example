NODE_ENV=production
PORT=3000
DOMAIN=example.com

# MongoDB chạy trong docker-compose (service "mongo"), không cần Atlas
MONGO_INITDB_ROOT_USERNAME=dengosaigon
MONGO_INITDB_ROOT_PASSWORD=replace-with-a-strong-password
MONGO_INITDB_DATABASE=den-go-sai-gon
MONGODB_URI=mongodb://dengosaigon:replace-with-a-strong-password@mongo:27017/den-go-sai-gon?authSource=admin
JWT_SECRET=replace-with-a-long-random-string
FRONTEND_URL=https://example.com

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_EMAIL_TO=admin@example.com

SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Đèn Gỗ Sài Gòn <shop@example.com>"
SMTP_SECURE=false

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

SEED_DEMO=false
