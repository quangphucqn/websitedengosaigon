; BIND zone file for denthucong.site — import into Cloudflare via DNS > Import and Export
; Generated 2026-09-23 from Tenten records (IP 157.66.218.158)
$ORIGIN denthucong.site.
$TTL 3600
@   IN  SOA kai.ns.cloudflare.com. hostmaster.denthucong.site. (
            2026092301 ; serial (YYYYMMDDNN)
            3600       ; refresh
            600        ; retry
            604800     ; expire
            3600 )     ; minimum TTL

; A records
@       3600    IN  A       157.66.218.158
*       3600    IN  A       157.66.218.158
mail    3600    IN  A       157.66.218.158

; CNAME
www     3600    IN  CNAME   denthucong.site.

; MX
@       3600    IN  MX  10  mail.denthucong.site.

; SPF / TXT
@       3600    IN  TXT     "v=spf1 mx a ip4:157.66.218.158 ~all"
